<?xml version="1.0"?>
<package>
  <name>joints_teleop</name>
  <version>1.0.0</version>
  <description>
    The joints_teleop packages provides a simple
    command interface to control the arm, head, 
    laser and torso joints of the robot.
  </description>

  <maintainer email="rodolphe.matias@icloud.com">Rodolphe Matias de Sousa</maintainer>
  <author>Rodolphe Matias de Sousa</author>

  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>orocos_kdl</build_depend>
  <build_depend>nxt_msgs</build_depend>
  <build_depend>nxt_python</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>nxt1_ros</build_depend>
  <build_depend>nxt2_ros</build_depend>
  <build_depend>nxt_controllers</build_depend>

  <run_depend>orocos_kdl</run_depend>
  <run_depend>nxt_msgs</run_depend>
  <run_depend>nxt_python</run_depend>
  <run_depend>rospy</run_depend>
  <run_depend>sensor_msgs</run_depend>
  <run_depend>nxt1_ros</run_depend>
  <run_depend>nxt2_ros</run_depend>
  <run_depend>nxt_controllers</run_depend>
  
</package>
