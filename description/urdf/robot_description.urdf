<?xml version="1.0"?>
<!--
  BetaBot - robot LEGO MINDSTORMS NXT (2x NXT, Odroid C2, OpenCR, LD06, webcam).
  Dimensions derivees du scan 3D Polycam "meshes/betabot_scan.glb"
  (mesh LiDAR photogrammetrique, exporte a l'echelle metrique par Polycam).
  Echelle validee sur les pieces LEGO/MINDSTORMS connues :
   - la tete est une brique NXT (ref 98 du kit, 108.4 mm de long) : le scan
     donne 115 mm sur le grand axe de la tete (~6% d'epaisseur de surface
     photogrammetrique en plus),
   - les organes de traction reposent sur le sol avec un rayon de 25 mm,
     coherent avec tread_radius = 0.025 m dans nxt_controllers.
  Robot scanne : 417 mm (longueur, X) x 273 mm (largeur, Y) x 486 mm (hauteur, Z).
  Voir description/dimensions.json et description/generate_meshes.py.

  Conventions ROS : X avant, Y gauche, Z haut. Origine de base_link sur
  l'axe des organes de traction (tread_radius = 0.025 m comme dans
  nxt_controllers), base_footprint au sol. Dans le repere du scan Polycam
  (glTF : Y haut), l'avant du robot correspond au -Z du scan, d'ou la
  transformation X_ros = -Z_scan, Y_ros = -X_scan, Z_ros = Y_scan.

  Les noms de joints (left_tread, right_tread, torso_joint, head_joint,
  arms_joint, laser_joint) et de frames capteurs correspondent au code
  ROS existant (nxt1_ros, nxt2_ros, nxt_controllers) :
    NXT1 : right_bumper=P1, left_bumper=P2, back_bumper=P3, ultrasonic=P4,
           right_tread=A, torso_joint=B, left_tread=C
    NXT2 : sound=P1, color=P2, line_following=P3, rfid=P4,
           head_joint=A, laser_joint=B, arms_joint=C
-->
<robot name="betabot">

  <!-- ================= base / chenilles ================= -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="file:///betabot/description/meshes/betabot_base.stl"/>
      </geometry>
      <material name="lego_yellow">
        <color rgba="0.9 0.7 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.043" rpy="0 0 0"/>
      <geometry>
        <!-- enveloppe convexe de la base mesuree sur le scan :
             417 x 245 x 135 mm, centree sur l'axe de traction -->
        <box size="0.417 0.245 0.135"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
    </inertial>
  </link>

  <joint name="base_to_footprint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <!-- base_link est 25 mm au-dessus du sol (rayon des organes de traction) -->
    <origin xyz="0 0 -0.025" rpy="0 0 0"/>
  </joint>

  <!-- chenilles / roues motrices (NXT1 PORT_A / PORT_C) -->
  <link name="left_tread_link">
    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.133"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>
  <link name="right_tread_link">
    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.133"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>
  <joint name="left_tread" type="continuous">
    <parent link="base_link"/>
    <child link="left_tread_link"/>
    <origin xyz="0 0.0665 0" rpy="0 1.57079632679 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="right_tread" type="continuous">
    <parent link="base_link"/>
    <child link="right_tread_link"/>
    <origin xyz="0 -0.0665 0" rpy="0 1.57079632679 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= torse (NXT1 PORT_B) ================= -->
  <link name="torso_link">
    <visual>
      <geometry>
        <mesh filename="file:///betabot/description/meshes/betabot_torso.stl"/>
      </geometry>
      <material name="lego_yellow"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- enveloppe du torse mesuree sur le scan : 242 x 187 x 138 mm -->
        <box size="0.242 0.187 0.138"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0.05 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/>
    </inertial>
  </link>
  <joint name="torso_joint" type="revolute">
    <parent link="base_link"/>
    <child link="torso_link"/>
    <!-- axe du moteur NXT du torse, base de la colonne sur le scan (z=0.207 m) -->
    <origin xyz="0 0 0.182" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-2.967" upper="2.967" velocity="1.0"/>
  </joint>

  <!-- ================= bras (NXT2 PORT_C) ================= -->
  <link name="arms_link">
    <visual>
      <geometry>
        <mesh filename="file:///betabot/description/meshes/betabot_arms.stl"/>
      </geometry>
      <material name="lego_yellow"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.298 0.242 0.107"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0.02 0 0"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>
  <joint name="arms_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="arms_link"/>
    <!-- axe des moteurs d'epaules, niveau des epaules sur le scan :
         torso (z=0.207) + origine bras (z=0.078 m relatifs) -->
    <origin xyz="0 0 0.078" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" lower="-2.443" upper="4.363" velocity="1.0"/>
  </joint>

  <!-- ================= tete (NXT2 PORT_A) ================= -->
  <link name="head_link">
    <visual>
      <geometry>
        <mesh filename="file:///betabot/description/meshes/betabot_head.stl"/>
      </geometry>
      <material name="lego_grey">
        <color rgba="0.35 0.35 0.35 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.085 0 0.065" rpy="0 0 0"/>
      <geometry>
        <!-- brique NXT + capteurs mesures sur le scan : 115 x 100 x 130 mm,
             tete inclinee vers l'avant -->
        <box size="0.115 0.100 0.130"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0.085 0 0.065"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
  </link>
  <joint name="head_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="head_link"/>
    <!-- axe du cou : la tete demarre a z=0.356 m du sol sur le scan,
         soit 0.149 m au-dessus de l'origine du torse -->
    <origin xyz="0 0 0.149" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-7.156" upper="7.156" velocity="1.0"/>
  </joint>

  <!-- ================= laser / LiDAR (NXT2 PORT_B) ================= -->
  <!-- Le LD06 est monte sur l'axe motorise laser_joint (NXT2 PORT_B).
       Le driver ldlidar_stl publie le frame base_laser (core.launch). -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.036"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.036"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.018"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>
  <link name="base_laser"/>
  <joint name="laser_joint" type="revolute">
    <parent link="head_link"/>
    <child link="laser_link"/>
    <!-- montage sur le moteur du cou, sommet du robot (tete : 130 mm) -->
    <origin xyz="0 0 0.130" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-0.3" upper="2.0" velocity="1.0"/>
  </joint>
  <joint name="laser_frame_joint" type="fixed">
    <parent link="laser_link"/>
    <child link="base_laser"/>
    <!-- centre optique du LD06 : 18 mm au-dessus de sa base -->
    <origin xyz="0 0 0.018" rpy="3.14159265359 0 0"/>
  </joint>

  <!-- ================= webcam ================= -->
  <link name="usb_cam_link"/>
  <joint name="usb_cam_joint" type="fixed">
    <parent link="head_link"/>
    <child link="usb_cam_link"/>
    <!-- webcam montee sur la tete, axe optique vers l'avant (-X du scan) -->
    <origin xyz="0.09 0 0.065" rpy="0 0 0"/>
  </joint>

  <!-- ================= capteurs NXT1 ================= -->
  <link name="right_bumper_link"/>
  <link name="left_bumper_link"/>
  <link name="back_bumper_link"/>
  <link name="ultrasonic_sensor_link"/>

  <joint name="right_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_bumper_link"/>
    <!-- bord avant-droit de la base (le scan s'etend jusqu'a x=+0.209) -->
    <origin xyz="0.185 -0.045 0.070" rpy="0 0 0"/>
  </joint>
  <joint name="left_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_bumper_link"/>
    <origin xyz="0.185 0.045 0.070" rpy="0 0 0"/>
  </joint>
  <joint name="back_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_bumper_link"/>
    <origin xyz="-0.185 0 0.070" rpy="0 0 0"/>
  </joint>
  <joint name="ultrasonic_sensor_joint" type="fixed">
    <parent link="head_link"/>
    <child link="ultrasonic_sensor_link"/>
    <!-- capteur ultrason NXT (yeux) sur la face avant de la tete -->
    <origin xyz="0.115 0 0.065" rpy="0 0 0"/>
  </joint>

  <!-- ================= capteurs NXT2 ================= -->
  <link name="sound_sensor_link"/>
  <link name="color_sensor_link"/>
  <link name="line_following_sensor_link"/>
  <link name="rfid_sensor_link"/>

  <joint name="sound_sensor_joint" type="fixed">
    <parent link="head_link"/>
    <child link="sound_sensor_link"/>
    <origin xyz="0 0 0.100" rpy="0 0 0"/>
  </joint>
  <joint name="color_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="color_sensor_link"/>
    <!-- capteur couleur pointe vers le sol a l'avant -->
    <origin xyz="0.160 0 0.020" rpy="0 1.57079632679 0"/>
  </joint>
  <joint name="line_following_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="line_following_sensor_link"/>
    <!-- capteur lumiere suiveur de ligne, regarde le sol a l'avant -->
    <origin xyz="0.150 0 0.010" rpy="0 1.57079632679 0"/>
  </joint>
  <joint name="rfid_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rfid_sensor_link"/>
    <origin xyz="-0.100 0 0.100" rpy="0 0 0"/>
  </joint>

  <!-- ================= IMU OpenCR ================= -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.100 0 0.080" rpy="0 0 -1.57079632679"/>
  </joint>

</robot>
